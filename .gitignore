# ==============================================================================
# Monorepo Root .gitignore for Portfolio
# Includes: Next.js (portfolio-pcc), Vite React (admin-ui), Spring Boot (server)
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# IDE & Editor Files
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.pfx
*.p12

# ------------------------------------------------------------------------------
# Node / JavaScript / TypeScript (portfolio-pcc & admin-ui)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# TypeScript build cache
*.tsbuildinfo
next-env.d.ts

# Production / Build outputs
dist/
dist-ssr/
out/
build/
.next/
.vercel/

# Testing & Coverage
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# Java / Spring Boot / Maven (server)
# ------------------------------------------------------------------------------
target/
*.class

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
!.mvn/wrapper/maven-wrapper.jar

# Spring Tool Suite (STS) / Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# Log files
logs/
*.log

# ------------------------------------------------------------------------------
# Temporary files & Caches
# ------------------------------------------------------------------------------
*.tmp
*.temp
.cache/
